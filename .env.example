# Merchy's Design Bot - Environment Variables
# Copy this file to .env and fill in your values.
# Any value left as "your_..._here" or blank is treated as NOT configured,
# and that feature runs in demo/fallback mode instead of failing.

# Server
PORT=3000
# Public base URL used to build absolute image links in Asana comments and emails
# (leave blank to use the request host)
PUBLIC_URL=

# Recraft AI - https://www.recraft.ai/api
# With no key, the app serves 6 local black and white layout previews (demo mode).
RECRAFT_API_KEY=your_recraft_api_key_here
# Optional overrides (defaults shown)
RECRAFT_MODEL=recraftv3
RECRAFT_STYLE=vector_illustration

# Asana - Personal Access Token from https://app.asana.com/0/developer-console
# With no token, submissions are saved to ./submissions/*.json only.
ASANA_ACCESS_TOKEN=your_asana_pat_here
ASANA_WORKSPACE_GID=1210933746792503
# Optional: pin the Presale project instead of searching by name
ASANA_PRESALE_PROJECT_GID=

# Stripe - vector file paywall. With no key, the widget sends a vector request to the team instead.
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Email (Gmail SMTP) - Use an App Password, not your regular password
# Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=start@merchysmerch.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=Merchy's Design Studio <start@merchysmerch.com>

# Art director (live clarifying questions). Without it the built-in question bank is used.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Artist call booking. Single-use links need both token and event type URI; URL alone works as a plain link.
CALENDLY_TOKEN=
CALENDLY_EVENT_TYPE=
CALENDLY_URL=
